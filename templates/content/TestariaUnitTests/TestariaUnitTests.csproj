<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!--
      Deliberately no tModLoader reference. Tier 0 runs with no game, and the
      surest way to keep a unit test from silently depending on loader state
      is for those types not to be in scope at all.
    -->
    <PackageReference Include="Testaria.Core" Version="0.1.0-alpha.1" />
  </ItemGroup>

</Project>
