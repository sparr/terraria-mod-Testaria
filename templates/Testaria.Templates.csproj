<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Testaria.Templates</PackageId>
    <Title>Testaria project templates</Title>
    <Description>dotnet new templates for testing Terraria mods with Testaria: an in-game test mod covering tiers 1 and 2, and an out-of-game unit test project for tier 0.</Description>
    <PackageTags>dotnet-new;templates;terraria;tmodloader;testing</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/**/bin/**;content/**/obj/**" />
  </ItemGroup>

</Project>
