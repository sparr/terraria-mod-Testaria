<Project>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Locate a tModLoader install for the projects that need one. Set TML_PATH to
    override; otherwise the usual Steam library locations are tried. Projects
    that reference tModLoader guard on TestariaHasTml so that a checkout
    without the game still builds, which is what keeps CI green.
  -->
  <PropertyGroup>
    <tModLoaderSteamPath Condition="'$(tModLoaderSteamPath)' == '' And '$(TML_PATH)' != ''">$(TML_PATH)</tModLoaderSteamPath>
    <tModLoaderSteamPath Condition="'$(tModLoaderSteamPath)' == '' And Exists('$(HOME)/.local/share/Steam/steamapps/common/tModLoader/tMLMod.targets')">$(HOME)/.local/share/Steam/steamapps/common/tModLoader</tModLoaderSteamPath>
    <tModLoaderSteamPath Condition="'$(tModLoaderSteamPath)' == '' And Exists('$(HOME)/.steam/steam/steamapps/common/tModLoader/tMLMod.targets')">$(HOME)/.steam/steam/steamapps/common/tModLoader</tModLoaderSteamPath>
    <TestariaHasTml Condition="'$(tModLoaderSteamPath)' != '' And Exists('$(tModLoaderSteamPath)/tMLMod.targets')">true</TestariaHasTml>
    <TestariaHasTml Condition="'$(TestariaHasTml)' == ''">false</TestariaHasTml>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Prerelease on purpose. build.txt versions are 2 to 4 integers with no
      prerelease tag (PLAN.md section 6), so the .tmod side carries 0.1 while
      NuGet carries the honest SemVer.
    -->
    <Version>0.1.0-alpha.1</Version>
    <Product>Testaria</Product>
    <Authors>Clarence "Sparr" Risher</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sparr/terraria-mod-Testaria</RepositoryUrl>
    <PackageProjectUrl>https://github.com/sparr/terraria-mod-Testaria</PackageProjectUrl>
  </PropertyGroup>

</Project>
