<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 rather than net10.0 on purpose. The 1.4.4 mod toolchain targets
      net8.0 and the 1.4.5 one targets net10.0; a net8.0 assembly is
      referenceable from both, so the core stays usable whichever line a
      consuming mod is built against.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Testaria</RootNamespace>
    <AssemblyName>Testaria.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Game-independent core of Testaria, a testing framework for Terraria mods: assertions, test results and JUnit reporting, tile geometry, and the box arena. Carries no tModLoader reference by design, which is what keeps unit tests from silently depending on loader state.</Description>
    <PackageTags>terraria;tmodloader;testing;modding</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    The Tier 0 boundary analyzer rides along in this package rather than in one
    of its own. A tier 0 test project already references Testaria.Core, and
    the boundary is exactly what that project needs protecting from, so pairing
    them means nobody can take the helpers without the guard. ReferenceOutput-
    Assembly is false because the core must not depend on Roslyn at run time;
    the project reference is here only to order the build.
  -->
  <ItemGroup>
    <ProjectReference Include="../Testaria.Analyzers/Testaria.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../Testaria.Analyzers/bin/$(Configuration)/netstandard2.0/Testaria.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Makes TestariaLoaderStateAnalysis readable by the analyzer. -->
    <None Include="build/Testaria.Core.props" Pack="true" PackagePath="build/" />
  </ItemGroup>

</Project>
