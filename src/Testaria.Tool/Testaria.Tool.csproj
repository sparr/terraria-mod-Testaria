<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net8.0 rather than net10.0. This tool starts the game in a process of its
      own and never loads a game assembly, so it has no reason to demand the
      newest runtime from a machine that only needs to run it.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Testaria.Tool</RootNamespace>
    <AssemblyName>testaria</AssemblyName>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>testaria</ToolCommandName>
    <PackageId>Testaria.Tool</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Command line harness for Testaria: provisions a scratch tModLoader save directory, installs mods, runs a test suite inside a headless server, and reports the result as JUnit XML and an exit code.</Description>
    <PackageTags>terraria;tmodloader;testing;modding;cli</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- For ResultsLocation: where a run writes its report is one fact, and
         the mod and the harness must not each have their own copy of it. -->
    <ProjectReference Include="../Testaria.Core/Testaria.Core.csproj" />
  </ItemGroup>

</Project>
