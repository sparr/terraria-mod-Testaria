<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TestingEfficiencyTests</AssemblyName>
    <RootNamespace>TestingEfficiencyTests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <Import Project="..\tModLoader.targets" />

  <!--
    Private=false throughout: every one of these is resolved at runtime by
    tModLoader through build.txt, so copying them into this mod's output would
    have ModCompile try to pack somebody else's assembly.
  -->
  <ItemGroup>
    <ProjectReference Include="$(TestariaRepo)\src\Testaria\Testaria.csproj" Private="false" />
    <ProjectReference Include="$(TestariaRepo)\src\Testaria.Core\Testaria.Core.csproj" Private="false" />
  </ItemGroup>

  <!--
    The subject, by path rather than by project. A suite living in the mod's
    own repository would use a ProjectReference here; this one is outside it,
    and the distinction does not reach the tests.
  -->
  <ItemGroup>
    <Reference Include="TestingEfficiency" Private="false">
      <HintPath>..\TestingEfficiency\bin\Release\net10.0\TestingEfficiency.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
